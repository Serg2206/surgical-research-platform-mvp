# App
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://your-domain.vercel.app
NEXT_PUBLIC_SITE_URL=https://proffssv.site
NEXT_PUBLIC_CONTACT_EMAIL=contact@ssvnauka.com

# Auth
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# Database (PostgreSQL / Neon / Supabase)
DATABASE_URL=postgresql://user:password@host:5432/dbname?schema=public

# AI integration — key for the Abacus.ai platform proxy (apps.abacus.ai),
# NOT a raw OpenAI/Anthropic key. See README "AI-поиск" for details.
ABACUSAI_API_KEY=your-abacus-api-key
